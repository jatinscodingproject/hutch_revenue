<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Hutch Revenue</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="login-page">

<div class="login-bg-orb orb-one"></div>
<div class="login-bg-orb orb-two"></div>

<div class="login-card">
    <div class="login-logo">H</div>

    <div class="login-brand">Hutch Revenue</div>
    <h1>Welcome back</h1>
    <p class="login-subtitle">Sign in to your admin dashboard</p>

    <% if (error) { %>
        <div class="login-error">
            <span>!</span>
            <%= error %>
        </div>
    <% } %>

    <form action="/login" method="POST">
        <div class="field">
            <label>Username</label>
            <div class="input-wrap">
                <span>👤</span>
                <input
                    type="text"
                    name="username"
                    placeholder="Enter username"
                    autocomplete="username"
                    required
                >
            </div>
        </div>

        <div class="field">
            <label>Password</label>
            <div class="input-wrap">
                <span>🔒</span>
                <input
                    type="password"
                    name="password"
                    placeholder="Enter password"
                    autocomplete="current-password"
                    required
                >
            </div>
        </div>

        <button class="login-button" type="submit">
            Sign In
            <span>→</span>
        </button>
    </form>
</div>

</body>
</html>
